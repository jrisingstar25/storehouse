# Diplomas and graduation certificates are personal records. Unlike product
# images, they must never be fetchable by URL - guessing or leaking a filename
# would expose someone's documents. Everything here is denied outright and
# served only through admin/doctors/document/..., which checks authorisation
# first and streams the file.
<IfModule authz_core_module>
	Require all denied
</IfModule>
<IfModule !authz_core_module>
	Deny from all
</IfModule>
